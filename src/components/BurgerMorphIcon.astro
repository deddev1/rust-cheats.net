---
/**
 * Morphing burger → X icon (astro-component-kit BurgerMorphIcon pattern).
 * Presentational — place inside SheetTrigger so open state syncs via aria-expanded / data-state.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['burger-morph', className]} aria-hidden="true">
  <span class="burger-morph__line"></span>
  <span class="burger-morph__line"></span>
  <span class="burger-morph__line"></span>
</span>

<style>
  .burger-morph {
    display: inline-flex;
    width: 1.25rem;
    height: 1rem;
    flex-direction: column;
    justify-content: space-between;
  }

  .burger-morph__line {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition:
      transform 0.35s ease,
      opacity 0.25s ease;
  }

  :global(button[aria-expanded='true']) .burger-morph__line:nth-child(1),
  :global(button[data-state='open']) .burger-morph__line:nth-child(1),
  :global(button.is-menu-open) .burger-morph__line:nth-child(1),
  :global([data-slot='sheet-trigger'][aria-expanded='true']) .burger-morph__line:nth-child(1),
  :global([data-slot='sheet-trigger'][data-state='open']) .burger-morph__line:nth-child(1),
  :global([data-slot='sheet-trigger'].is-menu-open) .burger-morph__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(button[aria-expanded='true']) .burger-morph__line:nth-child(2),
  :global(button[data-state='open']) .burger-morph__line:nth-child(2),
  :global(button.is-menu-open) .burger-morph__line:nth-child(2),
  :global([data-slot='sheet-trigger'][aria-expanded='true']) .burger-morph__line:nth-child(2),
  :global([data-slot='sheet-trigger'][data-state='open']) .burger-morph__line:nth-child(2),
  :global([data-slot='sheet-trigger'].is-menu-open) .burger-morph__line:nth-child(2) {
    opacity: 0;
  }

  :global(button[aria-expanded='true']) .burger-morph__line:nth-child(3),
  :global(button[data-state='open']) .burger-morph__line:nth-child(3),
  :global(button.is-menu-open) .burger-morph__line:nth-child(3),
  :global([data-slot='sheet-trigger'][aria-expanded='true']) .burger-morph__line:nth-child(3),
  :global([data-slot='sheet-trigger'][data-state='open']) .burger-morph__line:nth-child(3),
  :global([data-slot='sheet-trigger'].is-menu-open) .burger-morph__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
