---
interface Props {
  class?: string;
  ariaLabel?: string;
  size?: 'default' | 'sm' | 'md';
}

const { class: className, ariaLabel = 'Toggle light and dark mode', size = 'default' } = Astro.props;
---

<label
  class:list={[
    'theme-switch',
    size === 'sm' && 'theme-switch--sm',
    size === 'md' && 'theme-switch--md',
    className,
  ]}
>
  <input
    type="checkbox"
    class="theme-switch__checkbox"
    aria-label={ariaLabel}
    data-sw-theme-control
    data-theme-on="dark"
    data-theme-off="light"
  />
  <div class="theme-switch__container">
    <div class="theme-switch__clouds" aria-hidden="true"></div>
    <div class="theme-switch__stars-container" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 144 55" fill="none">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
