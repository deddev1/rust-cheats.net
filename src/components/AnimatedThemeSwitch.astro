117.083 44.514 117.083 41.507 114.615 41.507Z"
          fill="currentColor"
        ></path>
      </svg>
    </div>
    <div class="theme-switch__circle-container">
      <div class="theme-switch__sun-moon-container">
        <div class="theme-switch__moon">
          <div class="theme-switch__spot"></div>
          <div class="theme-switch__spot"></div>
          <div class="theme-switch__spot"></div>
        </div>
      </div>
    </div>
  </div>
</label>

<script>
  import { initThemeController } from '@starwind-ui/astro/theme';

  const setupThemeController = () => {
    initThemeController();
  };

  setupThemeController();
  document.addEventListener('astro:after-swap', setupThemeController);
  document.addEventListener('starwind:init', setupThemeController);
</script>
