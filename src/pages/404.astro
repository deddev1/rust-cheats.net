---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';
---

<BaseLayout
  title="Rust Cheats 404 | Page Not Found"
  description="This Rust Cheats page could not be found. Browse undetected Rust ESP, aimbot products and buy guides on rust-cheats.net."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">Rust Cheats page not found</h1>
      <p class="mt-4 text-muted-foreground">
        That Rust Cheats URL does not exist or may have moved. Return home or shop ESP, aimbot and utility products.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button as="a" href={ROUTES.home} variant="primary">
          Back to home
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={ROUTES.products} variant="outline">Shop Rust products</Button>
        <Button as="a" href={ROUTES.productsElite} variant="outline">Buy Elite cheats</Button>
      </div>
    </div>
  </section>
</BaseLayout>
