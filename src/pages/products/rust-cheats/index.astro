---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { productHub, productPages } from '../../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import { productPath, ROUTES } from '../../../utils/path';
import { Prose } from '@/components/starwind/prose';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';

const seo = resolvePageSeo('/products/rust-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.products.title}</h1>
        <p class="text-lg text-muted-foreground">{t.products.subtitle}</p>
      </div>

      <Prose class="mt-8 max-w-none text-muted-foreground">
        <h2>Compare products before checkout</h2>
        <p>
          Elite bundles ESP, aimbot, no recoil and farm helpers for players who want the full suite. Utilities cover
          hardware resets after bans, UGC appeal workflows, and local Skin Changer previews. Read the{' '}
          <a href="/blog/lite-vs-pro/">Lite vs Pro guide</a>, <a href="/blog/buy-guide/">checkout walkthrough</a>, or{' '}
          <a href={ROUTES.faq}>FAQ</a> if you are deciding between plans.
        </p>
        <h3>What to compare before checkout</h3>
        <p>
          Each card below links to a product page with screenshots, system requirements, and module lists. When you are
          ready, use Get access for secure checkout. Check the homepage status banner before every session—especially
          after wipe day or an EAC update.
        </p>
      </Prose>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {productPages.map((product) => (
          <CatalogCard
            label={cardLabel(product)}
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            buyLabel="Get access"
            viewLabel="View details"
          />
        ))}
      </div>

      <SeoRelatedLinks title="More Rust cheat resources" />
    </div>
  </section>
</BaseLayout>
