---
import '../styles/reviews.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';
import { reviews, getReviewStats, getRatingBreakdown, getReviewProducts } from '../data/reviews';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];
const stats = getReviewStats();
const breakdown = getRatingBreakdown();
const products = getReviewProducts();
const [featured, ...feed] = reviews;

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Rust Cheats',
  description: seo.description,
  brand: { '@type': 'Brand', name: 'Rust Cheats' },
  url: canonicalUrl('/reviews/'),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(stats.average),
    reviewCount: String(stats.count),
    bestRating: '5',
    worstRating: '1',
  },
  review: reviews.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    datePublished: new Date(r.date).toISOString().slice(0, 10),
    reviewBody: r.body,
    name: r.title,
    reviewRating: {
      '@type': 'Rating',
      ratingValue: String(r.rating),
      bestRating: '5',
      worstRating: '1',
    },
  })),
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: 'Rust Cheats Customer Reviews',
      description: seo.description,
      url: '/reviews/',
    }),
    breadcrumbSchema(breadcrumbs),
    reviewSchema,
  ]}
>
  <div class="reviews-page">
    <section class="reviews-hero">
      <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
        <Breadcrumbs items={breadcrumbs} />
        <div class="reviews-hero__grid">
          <div class="reviews-hero__copy">
            <p class="section-header__eyebrow">Verified buyer signal</p>
            <h1 id="reviews-page-title" class="section-header__title">
              Rust Cheats Reviews — ESP, Aimbot & Spoofer
            </h1>
            <p class="section-header__subtitle mt-3 max-w-xl">
              Real purchase feedback on Elite combat tools, HWID Spoofer, UGC recovery and Skin Changer—before you checkout.
            </p>

            <div class="reviews-filters" role="group" aria-label="Filter reviews by product">
              <button type="button" class="reviews-filter is-active" data-review-filter="all" aria-pressed="true">
                All products
              </button>
              {
                products.map((product) => (
                  <button
                    type="button"
                    class="reviews-filter"
                    data-review-filter={product}
                    aria-pressed="false"
                  >
                    {product}
                  </button>
                ))
              }
            </div>
          </div>

          <aside class="reviews-score" aria-label="Aggregate rating summary">
            <div class="reviews-score__top">
              <div>
                <p class="reviews-score__value">
                  {stats.average}<span>/5</span>
                </p>
                <div class="reviews-score__stars" aria-hidden="true">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span class:list={[i < Math.round(stats.average) ? '' : 'opacity-30']}>★</span>
                  ))}
                </div>
              </div>
            </div>

            <div class="reviews-score__bars">
              {
                breakdown.map((row) => (
                  <div class="reviews-score__bar">
                    <span>{row.stars}★</span>
                    <div class="reviews-score__bar-track">
                      <div
                        class="reviews-score__bar-fill"
                        style={`width: ${row.pct}%`}
                      />
                    </div>
                    <span>{row.count}</span>
                  </div>
                ))
              }
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5" aria-labelledby="reviews-list-title">
      <div class="reviews-layout">
        <div>
          <h2 id="reviews-list-title" class="sr-only">Customer review list</h2>

          {
            featured && (
              <article
                class="reviews-featured"
                data-review-card
                data-review-product={featured.product}
              >
                <span class="reviews-featured__mark" aria-hidden="true">“</span>
                <p class="text-xs font-semibold uppercase tracking-wider text-primary">Featured review</p>
                <h3 class="reviews-featured__title mt-2">{featured.title}</h3>
                <p class="reviews-featured__body">{featured.body}</p>
                <div class="reviews-featured__meta">
                  <span class="reviews-avatar">{initials(featured.name)}</span>
                  <div>
                    <p class="reviews-item__name">{featured.name}</p>
                    <p class="reviews-item__handle">@{featured.handle}</p>
                  </div>
                  <div class="reviews-item__stars" aria-label={`${featured.rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <span class:list={[i < featured.rating ? '' : 'is-empty']} aria-hidden="true">★</span>
                    ))}
                  </div>
                  <a class="reviews-pill" href={featured.productHref}>{featured.product}</a>
                  <time class="reviews-pill reviews-pill--muted" datetime={featured.date}>{featured.date}</time>
                </div>
              </article>
            )
          }

          <ol class="reviews-feed">
            {
              feed.map((review) => (
                <li class="reviews-item" data-review-card data-review-product={review.product}>
                  <div class="reviews-item__aside">
                    <span class="reviews-avatar">{initials(review.name)}</span>
                    <div>
                      <p class="reviews-item__name">{review.name}</p>
                      <p class="reviews-item__handle">@{review.handle}</p>
                    </div>
                    <div class="reviews-item__stars" aria-label={`${review.rating} out of 5 stars`}>
                      {Array.from({ length: 5 }).map((_, i) => (
                        <span class:list={[i < review.rating ? '' : 'is-empty']} aria-hidden="true">★</span>
                      ))}
                    </div>
                  </div>
                  <div>
                    <h3 class="reviews-item__title">{review.title}</h3>
                    <p class="reviews-item__body">{review.body}</p>
                    <div class="reviews-item__foot">
                      {review.verified ? (
                        <span class="reviews-pill">
                          <Icon name="shieldCheck" size={12} class="icon-app--primary" />
                          Verified buy
                        </span>
                      ) : null}
                      <a class="reviews-pill" href={review.productHref}>{review.product}</a>
                      <time class="reviews-pill reviews-pill--muted" datetime={review.date}>{review.date}</time>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="reviews-empty" data-reviews-empty>No reviews match this product filter.</p>
        </div>

        <aside class="reviews-side">
          <div class="reviews-side__card">
            <h2>Shop after you read</h2>
            <p>Compare Elite ESP/aimbot and utility tools, then checkout for portal access and Discord support.</p>
            <div class="reviews-side__actions">
              <Button as="a" href={ROUTES.productsElite} variant="primary" class="w-full justify-center">
                Buy Elite
                <Icon name="arrowRight" size={16} />
              </Button>
              <Button as="a" href={ROUTES.products} variant="outline" class="w-full justify-center">
                All products
              </Button>
            </div>
          </div>
          <div class="reviews-side__card">
            <h2>Need setup help?</h2>
            <p>Loader errors and HWID questions go through Discord tickets—include your order ID.</p>
            <div class="reviews-side__actions">
              <Button as="a" href={ROUTES.support} variant="outline" class="w-full justify-center">
                Open support
              </Button>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </div>

  <script>
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-review-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-review-card]')];
    const empty = document.querySelector<HTMLElement>('[data-reviews-empty]');

    const applyFilter = (value: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = value === 'all' || card.dataset.reviewProduct === value;
        card.hidden = !match;
        if (match) visible += 1;
      });
      empty?.classList.toggle('is-visible', visible === 0);
      filters.forEach((btn) => {
        const active = btn.dataset.reviewFilter === value;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };

    filters.forEach((btn) => {
      btn.addEventListener('click', () => applyFilter(btn.dataset.reviewFilter || 'all'));
    });
  </script>
</BaseLayout>
